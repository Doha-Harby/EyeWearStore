NODE_ENV=development
PORT=5000
# Transactions (orders, stock) need a replica set. `docker compose up -d` in the repo root provides one.
MONGODB_URI=mongodb://localhost:27017/lumiere?replicaSet=rs0
CLIENT_URL=http://localhost:5173
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_use_a_long_random_string_of_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_long_random_string_32_chars
# Mail: leave SMTP_* unset to just print emails in the server console. For Ethereal/Mailtrap:
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
